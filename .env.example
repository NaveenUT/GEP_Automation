# Application
BASE_URL=
TIMEOUT=60000

# Login (APP_ prefix avoids clashing with the Windows USERNAME variable)
APP_USERNAME=
APP_PASSWORD=

# Tosca test case parameters
# Two-letter country code, e.g. NL, IT, UK
COUNTRY=
# genx | geny | genz
REGION=
# Medical | Dental (only used for UK)
DOMAIN=
USER_TYPE=

# Test data
PRODUCT_ID=
# Tosca TDM Condition OCOrderStatus: status shown on Order Details after submitting (compared case-insensitively)
EXPECTED_ORDER_STATUS=
# Recurring order frequency as shown in the dropdown (TDM recurringFrequency, per country)
RECURRING_FREQUENCY=

# Optional per-test overrides: <TC>_<NAME>, e.g. for GEP2-36899
GEP2_36899_APP_USERNAME=
GEP2_36899_APP_PASSWORD=
GEP2_36899_PRODUCT_ID=
GEP2_18230_APP_USERNAME=
GEP2_18230_APP_PASSWORD=
