# Copy to .env and fill in. .env is gitignored: credentials never go into code or git.

# Which environment to run: qa | uat | prod (default qa). prod also needs ALLOW_PROD=true and runs only @prod-safe tests.
TEST_ENV=qa
# ALLOW_PROD=true
# Which market(s) to run: us | uk-dental | uk-medical (comma-separated for several)
MARKET=us

# Test data database (SQL Server, tables in db/schema.sql): site URL/region per env + market, and the login users.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=GEP_DB
DB_USER=gep_automation
DB_PASSWORD=
# Key used with ENCRYPTBYPASSPHRASE when the users were inserted
DB_ENCRYPTION_KEY=
# DB_ENCRYPT=false                  default true
# DB_TRUST_SERVER_CERTIFICATE=false default true (a local SQL Server has a self-signed certificate)

# Run settings
TIMEOUT=90000
# HEADLESS=true

# Fallback when DB_SERVER is not set, or the database is unreachable on QA: the QA default user per market,
# <MARKET>_<ENV>_APP_USERNAME / _APP_PASSWORD
US_QA_APP_USERNAME=
US_QA_APP_PASSWORD=
UK_DENTAL_QA_APP_USERNAME=
UK_DENTAL_QA_APP_PASSWORD=
UK_MEDICAL_QA_APP_USERNAME=
UK_MEDICAL_QA_APP_PASSWORD=

# Optional override
#   <MARKET>_<ENV>_BASE_URL                other URL for a market, e.g. US_QA_BASE_URL=

# ---- Demo Web Shop (second application: tests/demo, run with --project=demo-webshop)
# DEMO_WEBSHOP_BASE_URL=            optional, default https://demowebshop.tricentis.com
DEMO_WEBSHOP_USERNAME=
DEMO_WEBSHOP_PASSWORD=
# TC04 mail steps 22-25 (without these the test is skipped after the Excel report):
DEMO_MAIL_SMTP_HOST=
# DEMO_MAIL_SMTP_PORT=587
DEMO_MAIL_SMTP_USER=
DEMO_MAIL_SMTP_PASSWORD=
# DEMO_MAIL_FROM=                   default: DEMO_MAIL_SMTP_USER
DEMO_MAIL_IMAP_HOST=
# DEMO_MAIL_IMAP_PORT=993
DEMO_MAIL_IMAP_USER=
DEMO_MAIL_IMAP_PASSWORD=
# DEMO_MAIL_TO=                     default: DEMO_MAIL_IMAP_USER
