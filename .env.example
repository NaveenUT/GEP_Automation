# Application
BASE_URL=
TIMEOUT=60000

# Login (APP_ prefix avoids clashing with the Windows USERNAME variable)
APP_USERNAME=
APP_PASSWORD=

# Tosca test case parameters
# Two-letter country code, e.g. NL, IT, UK
COUNTRY=
# genx | geny | genz
REGION=
# Medical | Dental (only used for UK)
DOMAIN=
USER_TYPE=

# Test data
PRODUCT_ID=
# Tosca TDM Condition OCOrderStatus: status shown on Order Details after submitting (compared case-insensitively)
EXPECTED_ORDER_STATUS=
# Recurring order frequency as shown in the dropdown (TDM recurringFrequency, per country)
RECURRING_FREQUENCY=
# Product with a primary and a secondary UOM (Tosca TDM Condition 'Productwith2UOM')
UOM_PRODUCT_ID=

# Per-country values: <COUNTRY>_<NAME> is used when COUNTRY matches, e.g. COUNTRY=US reads US_BASE_URL.
# Any key without a country block falls back to the shared key above. A country key that is present
# but empty counts as missing (it does not fall back), so one country never uses another's values.
# Works for BASE_URL, APP_USERNAME, APP_PASSWORD, REGION, DOMAIN, USER_TYPE, PRODUCT_ID,
# UOM_PRODUCT_ID and RECURRING_FREQUENCY.
US_BASE_URL=
US_APP_USERNAME=
US_APP_PASSWORD=
US_REGION=
US_DOMAIN=
US_PRODUCT_ID=
US_UOM_PRODUCT_ID=

# Optional per-test overrides: <TC>_<NAME>, e.g. for GEP2-36899
GEP2_36899_APP_USERNAME=
GEP2_36899_APP_PASSWORD=
GEP2_36899_PRODUCT_ID=
GEP2_18230_APP_USERNAME=
GEP2_18230_APP_PASSWORD=
