# Copy to .env and fill in. .env is gitignored: credentials never go into code or git.

# Which market(s) to run: us-qa | uk-dental-qa | uk-medical-qa (comma-separated for several)
MARKET=us-qa

# Run settings
TIMEOUT=90000
# HEADLESS=true

# Credentials per market: <PREFIX>_APP_USERNAME / <PREFIX>_APP_PASSWORD (prefixes in src/config/markets.ts)
US_QA_APP_USERNAME=
US_QA_APP_PASSWORD=
UK_DENTAL_QA_APP_USERNAME=
UK_DENTAL_QA_APP_PASSWORD=
UK_MEDICAL_QA_APP_USERNAME=
UK_MEDICAL_QA_APP_PASSWORD=

# Optional overrides
#   <PREFIX>_BASE_URL                      other URL for a market, e.g. US_QA_BASE_URL=
#   <TC>_APP_USERNAME / _APP_PASSWORD        user for one test case on every market, e.g. GEP2_36899_APP_USERNAME=
#   <TC>_<PREFIX>_APP_USERNAME / _PASSWORD   user for one test case on one market, e.g. GEP2_36899_UK_DENTAL_QA_APP_USERNAME=
